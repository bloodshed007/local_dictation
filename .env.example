# Default: local CUDA transcription. No API key required.
STT_PROVIDER=faster-whisper
STT_MODEL=small
STT_DEVICE=cuda
STT_COMPUTE_TYPE=float16
STT_LANGUAGE=en
STT_SPEECH_RMS_THRESHOLD=650
STT_HOLD_KEY=f8
# Optional name substring; leave blank to follow the Windows default at startup.
STT_MIC_DEVICE=

# Lightweight local CPU fallback:
# STT_PROVIDER=vosk

# Optional cloud provider:
# STT_PROVIDER=deepgram
# DEEPGRAM_API_KEY=replace_with_your_deepgram_api_key
